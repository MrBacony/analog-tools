{
  "name": "analog-example",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "analog-example",
  "sourceRoot": "apps/analog-example/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@analogjs/platform:vite",
      "defaultConfiguration": "production",
      "outputs": ["{workspaceRoot}/dist/apps/analog-example"],
      "options": {
        "main": "apps/analog-example/src/main.ts",
        "configFile": "apps/analog-example/vite.config.ts",
        "outputPath": "dist/apps/analog-example/client",
        "tsConfig": "apps/analog-example/tsconfig.app.json"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "sourcemap": false,
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@analogjs/platform:vite-dev-server",
      "continuous": true,
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "analog-example:build",
        "port": 4200
      },
      "configurations": {
        "development": {
          "buildTarget": "analog-example:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "analog-example:build:production"
        }
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "analog-example:build",
        "port": 4200,
        "staticFilePath": "dist/apps/analog-example/browser",
        "spa": true
      },
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"]
    },
    "test": {
      "executor": "@analogjs/vitest-angular:test",
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "config": "vite.config.ts"
      }
    }
  }
}
